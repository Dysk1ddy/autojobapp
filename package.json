{
  "name": "autojobapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.config.ts && vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "serve:e2e": "node scripts/e2e-server.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test:run && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.314",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@playwright/test": "^1.55.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.8.3",
    "vite": "^7.1.5",
    "vitest": "^2.1.8"
  }
}
