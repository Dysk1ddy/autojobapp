{
  "manifest_version": 3,
  "name": "AutoJobApp",
  "version": "0.1.0",
  "description": "A privacy-first scaffold for job application form scanning and future autofill workflows.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://app.joinhandshake.com/*",
    "https://indeed.com/*",
    "https://*.indeed.com/*"
  ],
  "action": {
    "default_title": "AutoJobApp",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "autofill-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Autofill the active job application page"
    },
    "toggle-handshake-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle Handshake mode on the active job search page"
    },
    "toggle-indeed-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Indeed mode on the active job search page"
    }
  },
  "options_page": "options.html"
}
